{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": {
    "enabled": false,
    "provider": "kilo",
    "model": "mistralai/mistral-embed-2312"
  },
  "model": "kilo/deepseek/deepseek-v4.1-flash",
  "small_model": "kilo/moonshotai/kimi-k2.6",
  "default_agent": "code-implementor",
  // Maximum subagent nesting depth. Default 1 blocks any subagent from dispatching its own subagents.
  // The delivery hierarchy is milestone (0) -> generation/story coordinator (1) -> sub-coordinator (2)
  // -> leaf worker (3), and change-control can nest one deeper; 5 gives headroom.
  "subagent_depth": 5,
  "instructions": [".kilo/rules/system-rules.md"],
  "agent": {
    "story-planning-coordinator": {
      "description": "Formulate one story from a settled plan; runs the story write/review/criticize loop",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/story-planning-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "story-implementation-coordinator": {
      "description": "Execute one story's tasks with per-task review and end-of-story critic; drives its PR to green",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/story-implementation-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "plan-generation-coordinator": {
      "description": "Formulate or revise a plan from the settled specifications",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/plan-generation-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "plan-to-story-coordinator": {
      "description": "Decompose a plan into its story set and resolve cross-story conflicts",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/plan-to-story-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "milestone-generation-coordinator": {
      "description": "Define milestones and their acceptance flows, close gaps, define arcs, drive plan/story generation, and schedule waves; change-control owner",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/milestone-generation-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "milestone-implementation-coordinator": {
      "description": "Execute approved milestones, run the milestone-close evaluation, and integrate PRs",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/milestone-implementation-coordinator.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "code-implementor": {
      "description": "Software developer for a task: write, modify, and refactor code and tests following project conventions",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/code-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "write-implementor": {
      "description": "Technical writer for a task: author and edit documents following the project's writing guidance",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/write-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "small-code-implementor": {
      "model": "kilo/moonshotai/kimi-k2.6",
      "description": "Lightweight software developer for narrow, mechanical coding tasks",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/small-code-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "big-code-implementor": {
      "description": "Software developer for large, complex coding tasks spanning many files",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/big-code-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "small-write-implementor": {
      "model": "kilo/moonshotai/kimi-k2.6",
      "description": "Lightweight technical writer for narrow document changes",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/small-write-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "big-write-implementor": {
      "description": "Technical writer for large documentation tasks and document sets",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/big-write-implementor.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "flow-verifier": {
      "description": "Verify one milestone acceptance flow (automated test, agent-driven, or manual report) and return evidence",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/flow-verifier.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "spec-reviewer": {
      "description": "Review a specification for conformance to its assigned intent",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/spec-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "plan-reviewer": {
      "description": "Review a plan for conformance to the requirements and settled decisions it implements",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/plan-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "story-reviewer": {
      "description": "Review a story at authoring and at completion for conformance to its plan",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/story-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "code-reviewer": {
      "description": "Review a task's code changes for conformance to the task specification",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/code-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "write-reviewer": {
      "description": "Review a task's document changes for conformance to the task specification",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/write-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "milestone-reviewer": {
      "description": "Review a milestone for conformance to the agreed capability, flows, components, and arcs",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/milestone-reviewer.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "design-critic": {
      "description": "Critique specifications against patterns, principles, and the architecture Definition of Done",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/design-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "plan-critic": {
      "description": "Critique plans against the plan standards, template, and organization rules",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/plan-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "story-critic": {
      "description": "Critique stories against the story standards, sizing, and parallelism rules",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/story-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "code-critic": {
      "description": "Critique code changes and walkthroughs against the coding conventions and patterns",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/code-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "write-critic": {
      "description": "Critique documents and walkthroughs against the writing guidance and terminology",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/write-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "milestone-critic": {
      "description": "Critique milestones against the milestone template, flow rules, arc definition, and planning standards",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/milestone-critic.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "architect": {
      "description": "Author and refine requirements, architecture, and design with the human",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/architect.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "allow", "skill": "allow" }
    },
    "plan-author": {
      "description": "Author plan and story prose on behalf of the generation coordinators",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/plan-author.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "integrator": {
      "description": "Perform rebase, push, PR, and CI operations for the milestone coordinators",
      "mode": "subagent",
      "prompt": "Read the file .kilo/personas/integrator.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "ask": {
      "description": "Read-only inquiry and explanation",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/ask.md for instructions.",
      "permission": { "read": "allow", "edit": "deny", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "debug": {
      "description": "Diagnose and fix software defects outside the story flow",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/debug.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    },
    "mock": {
      "description": "UI/UX prototyping and mockups",
      "mode": "all",
      "prompt": "Read the file .kilo/personas/mock.md for instructions.",
      "permission": { "read": "allow", "edit": "allow", "bash": "allow", "task": "deny", "skill": "allow" }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "experimental": {
    "codebase_search": true,
    "openTelemetry": true
  }
}
