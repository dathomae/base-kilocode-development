#!/usr/bin/env bash
#
# Interim guard: refuse pushes to human-only branches (main/master).
#
# Agents push story/* and agent-main only; a human merges agent-main -> main.
# This is a safety net, not enforcement — branch protection is the real control.
#
# The human may deliberately push main with either:
#   git push --no-verify ...
#   ALLOW_MAIN_PUSH=1 git push ...
#
# Installed by scripts/install-git-guards.sh via core.hooksPath=.githooks.

set -euo pipefail

[ "${ALLOW_MAIN_PUSH:-0}" = "1" ] && exit 0

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      {
        echo "pre-push: refusing to push to $remote_ref — human-only branch."
        echo "          Push a story/* or agent-main branch and open a PR into agent-main instead."
        echo "          Human override: ALLOW_MAIN_PUSH=1 or 'git push --no-verify'."
      } >&2
      blocked=1
      ;;
  esac
done

[ "$blocked" -eq 0 ] || exit 1
exit 0
