{
    "connectors": [
        {
            "connector": "revenue_data",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/revenue_data.parquet"
                }
            ]
        },
        {
            "connector": "cost_data",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/cost_data.parquet"
                }
            ]
        }
    ],
    "outputs": [
        {
            "metric": "profit",
            "dimensions": ["Region", "Product"],
            "celltype": "revenue_amt",
            "grain": ["Year"]
        },
        {
            "metric": "margin_pct",
            "dimensions": ["Region", "Product"],
            "celltype": "revenue_amt",
            "grain": ["Year"]
        },
        {
            "metric": "markup",
            "dimensions": ["Region", "Product"],
            "celltype": "revenue_amt",
            "grain": ["Year"]
        }
    ],
    "architecture": {
        "cpu_cores": 4,
        "cache_size": 8388608,
        "main_memory_size": 17179869184
    }
