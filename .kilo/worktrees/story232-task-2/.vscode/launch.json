{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug cpl_compiler",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/chronocone_planning_language/src/main/go/cli/compiler/cpl_compiler.go",
            "args": [
                "-loglevel", "info",
                "-io", "${workspaceFolder}/src/chronocone_planning_language/examples/with_data/without_errors/metrics_conditionals/conditional_unary_negation/iospec.json",
                "-o", "${workspaceFolder}/src/chronocone_planning_language/generated/cmd/conditional_unary_negation/main.go",
                "${workspaceFolder}/src/chronocone_planning_language/examples/with_data/without_errors/metrics_conditionals/core.cpl",
                "${workspaceFolder}/src/chronocone_planning_language/examples/with_data/without_errors/metrics_conditionals/conditional_unary_negation/conditional_unary_negation.cpl"]
                
            "cwd": "${workspaceFolder}/src/chronocone_planning_language",
            "env": {},
            "showLog": true
        },
        {
            "name": "Debug generated conditional_logical_operators",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/chronocone_planning_language/generated/cmd/conditional_logical_operators/main.go",
            "args": [
                "-data-dir=examples/with_data/without_errors/metrics_conditionals/conditional_logical_operators"
            ],
            "cwd": "${workspaceFolder}/src/chronocone_planning_language",
            "env": {}
        },
        {
            "name": "Debug parquetgen",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/chronocone_planning_language/src/main/go/cli/parquetgen/parquet_gen.go",
            "args": [
                "-input", "examples/metrics_arithmetic/subtraction_division/parquet_gen_spec_a.json",
                "-json_output",  "examples/metrics_arithmetic/subtraction_division/data_a.json",
                "-output", "examples/metrics_arithmetic/subtraction_division/data_a.parquet"
            ],
            "cwd": "${workspaceFolder}/src/chronocone_planning_language",
            "env": {}
        }
    ],
    "inputs": [
        {
            "id": "cplFile",
            "type": "pickString",
            "description": "Select a CPL file to compile",
            "options": [
                "${workspaceFolder}/src/chronocone_planning_language/examples/without_errors/basic_concepts.cpl",
                "${workspaceFolder}/src/chronocone_planning_language/examples/without_errors/simple_units.cpl"
            ],
            "default": "${workspaceFolder}/src/chronocone_planning_language/examples/without_errors/basic_concepts.cpl"
        }
    ]
}
