{
    "connectors": [
        {
            "connector": "revenue_data",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "revenue_data.parquet"
                }
            ]
        }
    ],
    "outputs": [
        {
            "metric": "base_revenue",
            "dimensions": [
                "Region",
                "Product"
            ],
            "celltype": "revenue",
            "grain": [
                "SingleDay"
            ]
        },
        {
            "metric": "total",
            "dimensions": [
                "Region",
                "Product"
            ],
            "celltype": "revenue",
            "grain": [
                "SingleDay"
            ]
        }
    ],
    "architecture": {
        "cpu_cores": 2,
        "cache_size": 1048576,
        "main_memory_size": 1073741824
    }
}
