# Example-specific declarations for conditional_grain/monthly_data.
# Defines measures, connector, and metric used by this example.

measures
    data_count = Count(unit=Month)
    Monthly = Interval(unit=Month)

connectors
    monthly_data = dimensions [Month, DayInMonth] grain Monthly celltype data_count

metrics
    total_count
        inputs
            metric monthly_data
        calculate
            monthly_data
