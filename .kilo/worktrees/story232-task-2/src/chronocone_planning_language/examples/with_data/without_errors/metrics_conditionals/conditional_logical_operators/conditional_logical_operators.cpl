# Conditional Logical Operators Example
# Demonstrates combining comparison expressions with logical operators
# in conditions: 'and', 'or', and 'not'. A third input (data_c) is used
# so that all four branches are exercised, including the else fallback.
#
# Branch coverage:
#   if (a>0 and b>0)          → both positive       → a + b
#   else if (a>0 or b>0)      → one positive         → a - b
#   else if not (a>0 or b>0) and c>0   → neither positive, c positive → b * c
#   else                      → remaining            → 0

measures
    data_a = Count(unit=Package)
    data_b = Count(unit=Package)
    data_c = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a
    data_b = dimensions [Region] grain Daily celltype data_b
    data_c = dimensions [Region] grain Daily celltype data_c

metrics
    conditional_metric
        inputs
            metric data_a
            metric data_b
            metric data_c
        calculate
            if data_a > 0 and data_b > 0
                data_a + data_b
            else if data_a > 0 or data_b > 0
                data_a - data_b
            else if not (data_a > 0 or data_b > 0) and data_c > 0
                data_b * data_c
            else
                0
            end if
