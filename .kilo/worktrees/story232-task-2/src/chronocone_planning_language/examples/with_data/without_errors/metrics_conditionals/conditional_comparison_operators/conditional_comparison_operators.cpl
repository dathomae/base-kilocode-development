# Conditional Comparison Operators Example
# This file demonstrates ==, !=, >=, <=, >, < operators used in conditional branches.
# Branches are ordered so that each clause is reachable with appropriate test data:
#   data_a == 10  → branch 1
#   data_a >= 8   → branch 2 (9 or 8, since 10 is caught above)
#   data_a <= 3   → branch 3 (3, 2, 1, 0)
#   data_a > data_b → branch 4 (4, 5, 6, 7 only when > data_b)
#   data_a != 5   → branch 5 (4, 6, 7 only when ≤ data_b)
#   else          → branch 6 (data_a == 5 and ≤ data_b)

measures
    data_a = Count(unit=Package)
    data_b = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a
    data_b = dimensions [Region] grain Daily celltype data_b

metrics
    comparison_metric
        inputs
            metric data_a
            metric data_b
        calculate
            if data_a == 10
                data_a + data_b
            else if data_a >= 8
                data_a - data_b
            else if data_a <= 3
                data_a / 2
            else if data_a > data_b
                data_a + data_b
            else if data_a != 5
                data_a * 2
            else
                data_b - data_a
            end if
