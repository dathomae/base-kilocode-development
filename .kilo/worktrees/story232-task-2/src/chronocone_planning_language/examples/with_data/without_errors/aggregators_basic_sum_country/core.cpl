# Core infrastructure for aggregators_basic examples.
# Defines concepts, measures, and a source data connector
# for demonstrating aggregation operations.

concepts
    Country = [Values[USA, Canada]]
    Product = [Values[widget, gadget]]

units
    Country=Country
    Product=Product

types
    Numeric = Number(precision=2)

measures
    sales = Numeric(unit=Product)

connectors
    source_data = dimensions [Country, Product] grain Daily celltype sales
