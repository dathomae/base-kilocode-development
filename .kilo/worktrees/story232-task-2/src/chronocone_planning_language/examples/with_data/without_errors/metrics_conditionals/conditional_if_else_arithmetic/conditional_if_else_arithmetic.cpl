# Conditional If/Else with Arithmetic
# This file demonstrates basic if/else conditional expression where both
# branches contain arithmetic expressions (addition and subtraction).
# The if branch adds two inputs; the else branch subtracts them.

concepts
    Day = [Values[Monday]]

measures
    data_a = Count(unit=Package)
    data_b = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a
    data_b = dimensions [Region] grain Daily celltype data_b

metrics
    conditional_metric
        inputs
            metric data_a
            metric data_b
        calculate
            if data_a > data_b
                data_a + data_b
            else
                data_a - data_b
            end if
