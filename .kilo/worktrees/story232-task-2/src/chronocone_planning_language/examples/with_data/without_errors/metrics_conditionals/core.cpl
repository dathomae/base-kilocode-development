# Core infrastructure for metrics_conditionals examples.
# Defines shared concepts, types, and units used across all conditional examples.
# This file is passed to the compiler alongside each example file.
concepts
    Region = [Values[North, South]]
    Package = [Values[Each]]

units
    Package=Package
    Region=Region

types
    Count = Number(precision=0)

measures
    packages = Count(unit=Package)
    
