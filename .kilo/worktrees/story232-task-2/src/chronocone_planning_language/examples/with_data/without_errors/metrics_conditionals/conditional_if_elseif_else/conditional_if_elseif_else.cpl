# Conditional If/Else If - Multi-Branch (No Else)
# This file demonstrates a two-branch conditional with if and else if only.
# No else branch exists; all positions are covered by the two branches.

concepts
    Day = [Values[Monday]]

measures
    data_a = Count(unit=Package)
    data_b = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a
    data_b = dimensions [Region] grain Daily celltype data_b

metrics
    conditional_metric
        inputs
            metric data_a
            metric data_b
        calculate
            if data_a > 10
                data_a * 2
            else if data_a <= 10
                data_a + data_b
            end if
