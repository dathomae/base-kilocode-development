# Conditional When/Default Example
# Demonstrates the when/default alternative conditional syntax with first-matching-wins semantics.

measures
    data_a = Count(unit=Package)
    data_b = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a
    data_b = dimensions [Region] grain Daily celltype data_b

metrics
    conditional_metric
        inputs
            metric data_a
            metric data_b
        calculate
            when
                data_a > data_b =>
                    data_a + data_b data_a < data_b =>
                        data_b - data_a default =>
                            data_a * 2 end when
