# Short form metric addition example.
# Demonstrates binary '+' using short form syntax.
# Functionally equivalent to simple_addition, but expressed as:
#   sum_metric = input_a + input_b
# Inputs are auto-derived by the analyzer from the expression.

connectors
    input_a = dimensions [Region] grain Daily celltype packages
    input_b = dimensions [Region] grain Daily celltype packages

metrics
    sum_metric = input_a + input_b