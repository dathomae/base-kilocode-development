# Parentheses overriding natural precedence: + and - execute before *.
# Demonstrates explicit grouping with four inputs.
# This file declares its own connectors.

connectors
    input_a = dimensions [Region] grain Daily celltype packages
    input_b = dimensions [Region] grain Daily celltype packages
    input_c = dimensions [Region] grain Daily celltype packages
    input_d = dimensions [Region] grain Daily celltype packages

metrics
    paren_metric
        inputs
            metric input_a
            metric input_b
            metric input_c
            metric input_d
        calculate
            (input_a + input_b) * (input_c - input_d)
