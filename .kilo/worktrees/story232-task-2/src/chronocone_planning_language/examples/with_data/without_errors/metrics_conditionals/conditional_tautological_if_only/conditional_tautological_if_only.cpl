# Example: Conditional Tautological If Only
# This file demonstrates a tautological if conditional (condition is always true)
# with no else branch. All positions select the single branch and produce correct values.

measures
    data_a = Count(unit=Package)

connectors
    data_a = dimensions [Region] grain Daily celltype data_a

metrics
    tautology_metric
        inputs
            metric data_a
        calculate
            if True
                data_a * 2
            end if
