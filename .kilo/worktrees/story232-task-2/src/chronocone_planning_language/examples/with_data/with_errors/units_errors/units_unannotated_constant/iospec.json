{
  "connectors": [
    {
      "connector": "connector_a",
      "data_format": "parquet",
      "driver": "file",
      "driver_parameters": [
        {
          "path": "data_a.parquet"
        }
      ]
    }
  ],
  "outputs": [
    {
      "metric": "temp_out",
      "dimensions": ["Region"],
      "celltype": "temperature",
      "grain": ["SingleDay"],
      "unit": "Fahrenheit"
    }
  ],
  "architecture": {
    "cpu_cores": 2,
    "cache_size": 1048576,
    "main_memory_size": 1073741824
  }
}
