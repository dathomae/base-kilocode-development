measures
    revenue_usd = Amount(unit=USD)
    revenue_eur = Amount(unit=EUR)

connectors
    connector_a = dimensions [Region] grain SingleDay celltype revenue_usd
    connector_b = dimensions [Region] grain SingleDay celltype revenue_eur

metrics
    total_revenue
        inputs
            metric connector_a
            metric connector_b
        calculate
            connector_a + connector_b
