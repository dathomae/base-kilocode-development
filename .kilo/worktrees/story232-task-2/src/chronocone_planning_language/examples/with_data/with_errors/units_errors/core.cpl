concepts
    Currency = [Values[USD, EUR, GBP]]
    Length = [Values[Meter, Kilometer, Centimeter]]
    TemperatureScale = [Values[Celsius, Fahrenheit, Kelvin]]
    Region = [Values[North, South]]

units
    USD = Currency
    EUR = Currency
    GBP = Currency
    Meter = Length
    Kilometer = Length
    Centimeter = Length
    Celsius = TemperatureScale
    Fahrenheit = TemperatureScale
    Kelvin = TemperatureScale
    Region = Region

types
    Amount = Number(precision=2)
    Distance = Number(precision=2)
    Temperature = Number(precision=2)

measures
    SingleDay = Interval(unit=DayOfWeek)
