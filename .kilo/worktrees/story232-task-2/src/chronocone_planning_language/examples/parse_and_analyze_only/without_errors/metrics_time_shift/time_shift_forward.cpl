# Forward time-shifted metric input.
# Metric Forecast references metric Base with forward(month) time shift.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

measures
    base = Number(unit=Unit)
    Daily = Interval(unit=Day)

metrics
    my_forecast
        inputs
            metric base forward(month)
        calculate
            0
