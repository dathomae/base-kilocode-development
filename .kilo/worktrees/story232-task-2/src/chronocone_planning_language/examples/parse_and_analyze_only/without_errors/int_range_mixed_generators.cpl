# Mixed Generators Example
# This file demonstrates combining Values and Int range generators in a single concept.
# From Story124: CPL Concepts Analyzer - Range

concepts
    # Concept combining explicit Values with an Int range
    Mixed = [Values[A, B], Int[1, 3, 1]]

    # Multiple Values generators combined with Int range
    PriorityAndLevels = [Values[Low, Medium], Values[High], Int[1, 2, 1]]

    # Int range followed by Values generator
    NumberedCategories = [Int[10, 30, 10], Values[Other, Misc]]
