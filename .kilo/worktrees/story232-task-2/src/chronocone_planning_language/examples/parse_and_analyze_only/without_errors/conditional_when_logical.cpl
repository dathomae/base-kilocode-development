# Conditional When with Logical Operators
# This file demonstrates when/default syntax where conditions combine multiple
# comparisons using 'and' and 'or'. Tests that the when-clause condition
# parsing supports complex boolean expressions.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    when_logical_metric
        inputs
            metric input_a
            metric input_b
        calculate
            when
                input_a > 0 and input_b > 0 =>
                    input_a * input_b input_a <= 0 or input_b <= 0 =>
                        input_a + input_b default =>
                            0 end when
