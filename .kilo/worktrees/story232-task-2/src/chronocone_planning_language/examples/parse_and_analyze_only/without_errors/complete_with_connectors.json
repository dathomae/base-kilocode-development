            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/sales_forecast.parquet"
                }
            ]
        },
        {
            "connector": "sales_actuals",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/sales_actuals.parquet"
                }
            ]
        },
        {
            "connector": "inventory_levels",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/inventory_levels.parquet"
                }
            ]
        }
    ],
    "outputs": [
