# Multiple Measures Sections Example
# This file demonstrates multiple measures sections in a single CPL file.
# Each section creates its own MeasuresScope symbol table.
# From Story163: CPL Units and Measures Multiple Sections

concepts
    Country = [Values[USA, Canada, Mexico]]
    Mass = [Values[kg, lb, oz]]

units
    Currency = Country
    Weight = Mass

types
    CurrencyType = Number()
    MassType = Number()

measures
    # First section defines price measure
    Price = CurrencyType(unit=Currency)

measures
    # Second section defines shipping weight measure
    ShippingWeight = MassType(unit=Weight)
