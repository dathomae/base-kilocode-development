# Units Example CPL File
# This file demonstrates the units section syntax

concepts
    Country = [Values[USA, Canada, Mexico, Germany, Japan, UK, France]]
    Mass = [Values[kg, lb, oz, g]]
    Distance = [Values[m, km, mi, ft]]
    Currency = [Values[USD, EUR, GBP, JPY]]

units
    OriginCountry = Country
    DestCountry = Country
    Weight = Mass
    DistanceMiles = Distance
    ShippingCost = Currency
