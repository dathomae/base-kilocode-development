# Multi-Grain Connector Example
# This file demonstrates a connector with multiple grain dimensions.
# Multiple grains allow data to be analyzed at different temporal resolutions
# within the same connector, enabling both yearly and quarterly views.

concepts
    # Geographic regions for sales territories
    Region = [Values[NorthAmerica, Europe, Asia]]

    # Product categories
    Product = [Values[Widget, Gadget, Thingy]]

    # Fiscal quarters
    Quarter = [Values[Q1, Q2, Q3, Q4]]

measures
    # Revenue measure for sales data
    Revenue = Number(unit=Dollar)

    # Yearly grain interval measure
    Yearly = Interval(unit=Year)

    # Quarterly grain interval measure
    Quarterly = Interval(unit=Quarter)

connectors
    # A connector with multiple grain dimensions
    # The data can be aggregated at both yearly and quarterly granularity
    sales_data = dimensions [Region, Product] grain Yearly, Quarterly celltype Revenue
