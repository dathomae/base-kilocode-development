# Conditional Short Form
# This file demonstrates that short-form metric declarations (<name> = <expression>)
# support conditional expressions. The expression rule resolves to conditionalExpr,
# so if/else/end if can be used directly after =.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    short_cond = if input_a > input_b
        input_a + input_b
    else
        input_a - input_b
    end if
