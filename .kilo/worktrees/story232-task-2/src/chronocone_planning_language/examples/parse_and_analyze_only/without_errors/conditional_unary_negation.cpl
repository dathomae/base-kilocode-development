# Conditional Unary Negation
# This file demonstrates unary negation (-) and unary 'not' used in both
# condition expressions and branch body expressions.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    unary_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if not input_a > input_b
                -input_a
            else
                -(input_a + input_b)
            end if
