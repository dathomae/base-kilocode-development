# Conditional Logical Operators
# This file demonstrates combining comparison expressions with logical operators
# in conditions. Covers 'and', 'or', and 'not'.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    logical_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if input_a > 0 and input_b > 0
                input_a + input_b
            else if input_a > 0 or input_b > 0
                input_a
            else if not input_a > 0
                input_b
            else
                0
            end if
