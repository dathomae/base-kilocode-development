# Before/After Multiple Values Example
# Insert multiple new values at once with a single before/after clause.
# From Story125/Story126/Story201: CPL Concepts Parser/Analyzer - Before/After

concepts
	Priority=[Values[Low, Medium, High]]

concepts
	# Insert Critical and VeryHigh before Low (both placed before Low)
	Priority=[Values[Critical, VeryHigh]] before Low

	# Insert Urgent and SemiUrgent after Medium (both placed after Medium)
	Priority=[Values[Urgent, SemiUrgent]] after Medium
