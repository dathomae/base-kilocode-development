# Conditional If/Else with Arithmetic
# This file demonstrates the simplest if/else conditional expression where both
# branches contain arithmetic expressions (addition and subtraction).
# The if branch adds two inputs; the else branch subtracts them.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    conditional_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if input_a > input_b
                input_a + input_b
            else
                input_a - input_b 
            end if
