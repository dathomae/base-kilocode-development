{
    "connectors": [
        {
            "connector": "demand_data",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/demand_data.parquet"
                }
            ]
        },
        {
            "connector": "cost_data",
            "data_format": "parquet",
            "driver": "file",
            "driver_parameters": [
                {
                    "path": "./data/cost_data.parquet"
                }
            ]
        }
    ],
    "outputs": [
        {
            "metric": "revenue",
            "dimensions": ["Price"],
            "celltype": "demand_forecast",
            "grain": ["Day"]
        },
        {
            "metric": "profit",
            "dimensions": ["Cost"],
            "celltype": "cost_forecast",
            "grain": ["Day"]
        }
    ],
    "architecture": {
        "cpu_cores": 4,
        "cache_size": 8388608,
        "main_memory_size": 17179869184
    }
}
