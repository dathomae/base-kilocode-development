# Explicit amount in backward time shift.
# backward(day, 2) shifts back by 2 days.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

measures
    daily_metric = Number(unit=Unit)
    Daily = Interval(unit=Day)

metrics
    shifted_metric
        inputs
            metric daily_metric backward(day, 2)
        calculate
            0
