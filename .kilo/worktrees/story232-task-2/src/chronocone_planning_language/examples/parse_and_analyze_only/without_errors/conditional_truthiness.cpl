# Conditional Truthiness
# This file demonstrates that numeric values can be used directly as boolean
# conditions (zero = falsy, non-zero = truthy). Also demonstrates Nil and
# False/True literal usage in conditions.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    truthiness_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if input_a
                input_a * 2
            else if False
                input_b
            else if True
                input_a + input_b
            else
                0
            end if
