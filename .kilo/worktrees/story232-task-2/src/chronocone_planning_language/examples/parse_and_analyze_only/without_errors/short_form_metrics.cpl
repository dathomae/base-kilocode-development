# Short Form Metrics Example
# This file demonstrates short form metric syntax where metrics are declared
# as single-line assignments without explicit inputs or calculate blocks.
# Inputs are auto-derived from identifier references in the calculation expression.

concepts
    Region = [Values[North, South, East, West]]
    Package = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Package = Package
    Day = Day

types
    Count = Number(precision=0)

measures
    packages = Count(unit=Package)
    Daily = Interval(unit=Day)

connectors
    input_a = dimensions [Region] grain Daily celltype packages
    input_b = dimensions [Region] grain Daily celltype packages

metrics
    literal_metric = 42
    connector_metric = input_a
    arithmetic_metric = input_a + input_b
    mixed_short_long_metric = arithmetic_metric * 2
