# Multiple Connectors Example
# This file demonstrates defining multiple connectors in a single CPL file.
# Each connector can have different dimensions and cell types.

concepts
    # Store locations
    Store = [Values[StoreA, StoreB, StoreC]]
    
    # Product SKUs
    SKU = [Values[SKU001, SKU002, SKU003, SKU004]]
    
    # Warehouse locations
    Warehouse = [Values[WH1, WH2]]

measures
    # Sales revenue measure
    Revenue = Number(unit=Dollar)
    
    # Inventory count measure
    Quantity = Number(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    # First connector for sales data
    store_sales = dimensions [Store, SKU] grain Daily celltype Revenue
    
    # Second connector for inventory data
    warehouse_inventory = dimensions [Warehouse, SKU] grain Daily celltype Quantity
