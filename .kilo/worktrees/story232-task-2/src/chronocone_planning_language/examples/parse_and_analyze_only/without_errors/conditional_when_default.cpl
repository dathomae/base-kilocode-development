# Conditional When/Default
# This file demonstrates the when/default alternative conditional syntax.
# Each when clause pairs a boolean condition with an arithmetic result body via =>.
# The default clause provides the fallback.

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit
    Day = Day

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    when_metric
        inputs
            metric input_a
            metric input_b
        calculate
            when
                input_a > input_b =>
                    input_a + input_b input_a < input_b =>
                        input_b - input_a default =>
                            input_a * 2 end when
