# Concept Range Chained Example
# Chained Concept Range references (A references B, B references C).
# From Story128/Story129: CPL Concepts Parser/Analyzer - Concept Range

concepts
	# Base concept with explicit values
	Base=[Values[V1, V2, V3, V4, V5]]

	# Middle extracts a range from Base
	Middle=[Base[V1..V3]]

	# Top extracts a sub-range from Middle
	Top=[Middle[V1..V2]]
