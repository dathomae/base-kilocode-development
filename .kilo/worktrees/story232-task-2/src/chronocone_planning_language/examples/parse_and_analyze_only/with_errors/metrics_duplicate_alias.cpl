# Error Case: Duplicate Alias
# This metric has two inputs with the same alias 'df',
# which should trigger a duplicate alias analysis error.

concepts
	Region = [Values[North, South]]
	Package = [Values[Each]]
	Day = [Values[Monday]]

units
	Package = Package
	Region = Region
	Day = Day

types
	Count = Number(precision=0)

measures
	packages = Count(unit=Package)
	Daily = Interval(unit=Day)

connectors
	demand_fc = dimensions [Region] grain Daily celltype packages

metrics
	my_metric
		inputs
			metric demand_fc as df
			metric demand_fc as df
		calculate
			0
