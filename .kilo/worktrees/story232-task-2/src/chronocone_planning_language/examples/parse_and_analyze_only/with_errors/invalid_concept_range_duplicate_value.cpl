# Invalid Concept Range - Duplicate Value
# Concept Range generates a value that already exists from another generator.
# From Story128/Story129: CPL Concepts Parser/Analyzer - Concept Range

concepts
	# Source concept with known values
	Source=[Values[A, B, C]]

	# Subset has Values generator producing A, then Concept Range also produces A
	Subset=[Values[A], Source[A..C]]
