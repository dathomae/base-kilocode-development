# Error: Missing end if
# This file demonstrates an if block that is never closed with end if,
# causing a parse error.
#
# Expected error: Parse error — missing end if (unexpected EOF within conditional)

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    missing_end_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if input_a > 0
                input_a
            else
                input_b
