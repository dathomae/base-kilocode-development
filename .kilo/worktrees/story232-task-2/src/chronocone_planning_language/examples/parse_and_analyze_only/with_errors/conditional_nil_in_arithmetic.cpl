# Error: Nil in Arithmetic Context
# This file demonstrates Nil used as an arithmetic operand (+, -, *, /),
# which is prohibited. The analyzer must detect and reject this.
#
# Expected error: Nil in arithmetic context (analysis error, not parse error)

concepts
    Region = [Values[North, South]]
    Unit = [Values[Each]]
    Day = [Values[Monday]]

units
    Region = Region
    Unit = Unit

types
    NumberType = Number()

measures
    input_a = NumberType(unit=Unit)
    input_b = NumberType(unit=Unit)
    Daily = Interval(unit=Day)

connectors
    data_a = dimensions [Region] grain Daily celltype input_a
    data_b = dimensions [Region] grain Daily celltype input_b

metrics
    nil_arithmetic_metric
        inputs
            metric input_a
            metric input_b
        calculate
            if input_a > 0
                input_a + Nil
            else
                input_b
            end if
