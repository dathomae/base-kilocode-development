# Error: Undefined celltype measure
# This file demonstrates a lookup referencing a measure not defined in the measures section.
# This is a semantic error that should be caught during analysis.

concepts
    Region = [Values[North, South]]

measures
    Sales = Number(unit=Dollar)

lookups
    # ERROR: 'UndefinedMeasure' is not defined in measures section
    SalesIndex
        dimensions [Region]
        celltype UndefinedMeasure
