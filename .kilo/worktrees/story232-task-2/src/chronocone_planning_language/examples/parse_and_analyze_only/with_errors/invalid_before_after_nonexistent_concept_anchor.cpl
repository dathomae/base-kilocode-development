# Invalid Before/After - Nonexistent Concept Anchor
# The before/after anchor references a value that exists in a different concept, not the one being extended.
# From Story125/Story126/Story201: CPL Concepts Parser/Analyzer - Before/After

concepts
	Priority=[Values[Low, Medium, High]]
	Severity=[Values[Minor, Major, Critical]]

concepts
	# Error: 'Critical' exists in Severity, not in Priority
	Priority=[Values[Urgent]] before Critical
