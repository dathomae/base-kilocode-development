# Standard type definitions for the Chronocone Planning Language.
# These types are automatically included in every compilation.

types
	Currency = Number(precision=2)

	# Instant declarations constrain points in time by one or more fields.
	Midnight = Instant(year=Year,  week_number=WeekNumber, day_of_week=DayOfWeek, hour=0, minute=0, second=0)
	StartOfBusinessDay = Instant(year=Year, week_number=WeekNumber, day_of_week=DayOfWeek, hour=9, minute=0, second=0)

	StartOfYear = Midnight(year=Year, day_of_year=1)
	StartOfMonth = Midnight(year=Year, month=Month, day_of_month=1)
	StartOfWeek = Midnight(year=Year,  week_number=WeekNumber, day_of_week=Monday)
    
	FirstIsoWeek = Midnight(year=Year, week_number=1)

	Sunday = Midnight(year=Year, day_of_week=Sunday)
	Monday = Midnight(day_of_week=Monday)
	Tuesday = Midnight(day_of_week=Tuesday)
	Wednesday = Midnight(day_of_week=Wednesday)
	Thursday = Midnight(day_of_week=Thursday)
	Friday = Midnight(day_of_week=Friday)
	Saturday = Midnight(day_of_week=Saturday)

